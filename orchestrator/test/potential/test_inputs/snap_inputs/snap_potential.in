[BISPECTRUM]
numTypes = 1
twojmax = 12
rcutfac = 3.0
rfac0 = 0.99363
rmin0 = 0.0

wj = 1.0


radelem = 0.5

type = C
wselfallflag = 0
chemflag = 0
bzeroflag = 1
quadraticflag = 1

[CALCULATOR]
calculator = LAMMPSSNAP
energy = 1
force = 1
stress = 0

[SOLVER]
solver = SVD
compute_testerrs = 1
detailed_errors = 1

[OUTFILE]
output_style = SNAP
metrics = snap_potential.md
potential = snap_potential

[REFERENCE]
units = metal
atom_style = atomic

pair_style = zero 10.0
pair_coeff = * *


[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
dump_dataframe = 0

[MEMORY]
override = 0
