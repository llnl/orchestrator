{
    "potential": {
        "potential_type": "SNAP",
        "potential_args": {
            "template": "./test_inputs/snap_inputs/Ta-example.in",
            "species": [
                "Ta"
            ]
        }
    },
    "storage": {
        "storage_type": "COLABFIT",
        "storage_args": {
            "credential_file": "<STORAGE_CREDENTIAL_PATH>"
        }
    },
    "scheduler": {
        "scheduler_type": "<ASYNCH_SCHEDULER>",
        "scheduler_args": {
            "root_directory": "./potential",
            "queue": "<HPC_QUEUE>",
            "account": "<HPC_ACCOUNT>",
            "wait_freq": 20
        }
    },
    "dataset_handle": "<TEST_Ta_DATASET_HANDLE>",
    "training_args": {
        "energy_weight": 1e-9,
        "force_weight": 1.0,
        "stress_weight": 1e-9,
        "per_atom_weights": "test_inputs/snap_inputs/snap_weights.npz"
    }
}
